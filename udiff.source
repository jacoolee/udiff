udiff_root=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)

export PATH=$PATH:$udiff_root

alias d=udiff

function D {
    d=$(pwd)
    while [ ! -d "${d}/.git" ]; do
        d=$(realpath "$d/..")
    done

    git_repo_name=$(basename $d)
    git_branch_name=$(git rev-parse --abbrev-ref HEAD)
    title="${git_repo_name}[${git_branch_name}]"
    output_html_file=/tmp/${title}.html

    ENV_HTML=1 ENV_HTML_TITLE=${title} udiff $* > "${output_html_file}"
    open "${output_html_file}"
}
